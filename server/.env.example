PORT=5001
MONGODB_URI=mongodb://127.0.0.1:27017/playstation_game_zone
# MONGO_URI is also accepted for deployment environments using that convention.
# MONGO_URI=mongodb://127.0.0.1:27017/playstation_game_zone
CLIENT_ORIGIN=http://localhost:5173
JWT_SECRET=
ADMIN_USERNAME=choose-a-unique-admin-username
ADMIN_PASSWORD=replace-with-a-unique-password-at-least-12-characters
ADMIN_PIN=replace-with-a-non-sequential-6-digit-pin
ADMIN_PHONE=replace-with-the-admin-phone-number
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100
AUTH_RATE_LIMIT_MAX=10
LOCKOUT_THRESHOLD=5
LOCKOUT_DURATION_MS=120000
# Use one MongoDB URI and one Render service per customer deployment for isolation.
SHOP_NAME=Game Zone
SHOP_PHONE=
SHOP_ADDRESS=
# Optional: ISO timestamp. Staff APIs return 402 when this date passes.
# LICENSE_EXPIRES_AT=2027-01-01T00:00:00.000Z
